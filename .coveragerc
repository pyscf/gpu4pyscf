# Measure package source, not tests or unrelated checkout files.
[run]
branch = True
source = gpu4pyscf
omit =
    */tests/*
    */test/*
disable_warnings = include-ignored

[report]
omit = */test/*
    */_patch_pyscf.py
    *_experiment.py
    */df/int3c2e.py
    */nac/finite_diff.py
    */pbc/dft/multigrid.py
    */pbc/dft/multigrid_v2.py
    */qmmm/pbc/*
    */sem/*
    */drivers/*
    */tools/*
    */tdscf/ris.py
    */tdscf/math_helper.py
    */tdscf/krylov.py
    */tdscf/parameter.py
    */tdscf/spectralib.py
    */tdrks_ris*.py

# Regexes for lines to exclude from consideration
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code:
    def __repr__

    # Don't complain if tests don't hit defensive assertion code:
    raise RuntimeError
    raise NotImplementedError
    pass

    # Don't complain if non-runnable code isn't run:
    if 0:
    if __name__ == .__main__.:
    if sys.version_info.*:
    if DEBUG:
    except ImportError:

ignore_errors = True
precision = 2

[html]
directory = coverage_html_report
