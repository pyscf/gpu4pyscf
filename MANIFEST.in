include MANIFEST.in
include README.md setup.py CHANGELOG AUTHORS LICENSE NOTICE
recursive-include gpu4pyscf *.c *.cpp *.cu *.cuh *.h *.hpp
recursive-include gpu4pyscf/lib CMakeLists.txt *.cmake
include gpu4pyscf/lib/libxc_prune.patch

global-exclude *.py[cod]
global-exclude *~
#global-exclude *.cu
#global-exclude *.h
#global-exclude *.c
#global-exclude *.cuh
#global-exclude *.sh

prune */__pycache__
recursive-exclude */__pycache__ *

prune gpu4pyscf/lib/build
prune bytedance
prune benchmarks

prune builder
prune dockerfiles
prune docker
prune examples
prune wheelhouse

recursive-exclude *test*
recursive-include gpu4pyscf *.dat
recursive-include gpu4pyscf/lib/deps *.so
include gpu4pyscf/lib/*.so
exclude gpu4pyscf/lib.deps *.so.*
